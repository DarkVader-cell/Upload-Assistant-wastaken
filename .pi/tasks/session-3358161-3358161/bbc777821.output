compose:
# Standalone Whatbox Web UI instance for the Wastaken fork.
# Start with: podman compose -f docker-compose.local.yml up -d
services:
  upload-assistant-wastaken:
    image: ghcr.io/darkvader-cell/upload-assistant-wastaken:latest
    build:
      context: .
      dockerfile: Dockerfile
    container_name: upload-assistant-wastaken
    restart: unless-stopped
    # Host networking lets the container reach the host's local qBittorrent
    # Web API at 127.0.0.1:17416. The Web UI remains on host port 12345.
    network_mode: host
    command: ["--webui", "0.0.0.0:12345"]
    environment:
      PUID: "1000"
      PGID: "1000"
      # Keep runtime state in the mounted application data tree. The image
      # default (/state) is intentionally used by the generic deployment, but
      # this standalone Whatbox layout mounts data and tmp below the checkout.
      UA_DATA_DIR: "/Upload-Assistant"
      PYTHONPATH: "/Upload-Assistant"
      UA_BROWSE_ROOTS: "/mnt/seeding"
      TMPDIR: "/Upload-Assistant/tmp"
      MPLCONFIGDIR: "/Upload-Assistant/tmp/matplotlib"
      XDG_CACHE_HOME: "/Upload-Assistant/tmp/.cache"
    volumes:
      - /mnt/mpathf/artemisprime:/mnt/seeding:rw
      - ./docker-data/data:/Upload-Assistant/data:rw
      - ./docker-data/tmp:/Upload-Assistant/tmp:rw
      - ./docker-data/webui-auth:/root/.config/upload-assistant:rw
    stop_grace_period: 15s
    healthcheck:
      test: ["CMD-SHELL", "curl -sS -o /dev/null -w '%{http_code}' http://localhost:12345/api/health | grep -qE '^[2-4][0-9][0-9]$'"]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3
listeners:
all-ua-processes:
