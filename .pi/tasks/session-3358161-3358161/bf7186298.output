#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import json
import os
import socket
import sys
import threading

import filesystem
from daemon import Daemon
from pathwrapper import HelmPath as Path

# Configuration
DEBUG = True
SIZE_DIGITS = 8

USER = os.getenv('USER')
CONF = Path(os.getenv('HOME'), '.config', 'helm')
UDX = CONF / 'socket'

# State
server = None


def dbg(msg):
    if not DEBUG:
        return

    if not CONF.is_dir():
        os.makedirs(str(CONF))

    with (CONF / 'helmd.log').open(mode='a', encoding='utf-8') as f:
        f.write(msg + '\n')


def init():
    if not CONF.is_dir():
        if CONF.exists():
            CONF.unlink()
        os.makedirs(str(CONF))

    if UDX.exists():
        UDX.unlink()

    dbg('[+] initializing server')
    dbg('    config in %s' % CONF)

    try:
        global server
        server = socket.socket(socket.AF_UNIX)
        server.bind(str(UDX))
        UDX.chmod(mode=0o770)
        server.listen(5)
        dbg('    listening to socket %s' % UDX)
    except socket.error as e:
        dbg(str(e))


# Handle requests
class RequestHandler(threading.Thread):
    def __init__(self, conn):
        (self.sock, self.addr) = conn
        threading.Thread.__init__(self)

    def run(self):
        dbg('[+] ' + self.getName() + ' is running')
        sent = 0
        replies = []
        request_json = b''

        # Receive JSON
        recv_len = self.sock.recv(SIZE_DIGITS)
        if len(recv_len) > 0:
            recv_len = int(recv_len)
        else:
            dbg('[+] ' + self.getName() + ' connection closed by client')
            return

        while len(request_json) < recv_len:
            request_json += self.sock.recv(1024)

        dbg('    received %s bytes: %s' % (
            str(recv_len),
            request_json.decode('utf-8')
        ))

        # Handle request
        try:
            requests = json.loads(request_json.decode('utf-8'))
            dbg("    parsed json")
        except ValueError as e:
            return {'error': str(e)}

        for request in requests:
            reply = {}

            dbg("    request was %s" % json.dumps(request))

            if 'cmd' not in request:
                reply['error'] = '[Internal error] cmd missing'

            elif hasattr(filesystem, request['cmd']):
                try:
                    reply = getattr(filesystem, request['cmd'])(**request)
                except Exception as e:
                    reply['error'] = str(e)

            else:
                reply['error'] = '[Internal error] cmd not found'

            reply['cmd'] = request['cmd']
            replies.append(reply)

        # Build JSON replies
        try:
            reply_json = json.dumps(replies)
        except ValueError as e:
            dbg(str(e))

        reply_len = str(len(reply_json))
        reply = reply_len.zfill(SIZE_DIGITS) + reply_json

        try:
            dbg('    replied ' + reply_len + ' bytes: ' + reply_json)
        except ValueError as e:
            dbg(str(e))

        # Send JSON replies
        try:
            while sent < len(reply):
                sent = self.sock.send(reply.encode('utf-8'))
        except IOError as e:
            dbg(str(e))

        # Close the client socket
        self.sock.close()
        self.sock = None


class HelmDaemon(Daemon):
    def run(self):
        while True:
            rh = RequestHandler(server.accept())
            rh.daemon = True
            rh.start()


if __name__ == "__main__":
    daemon = HelmDaemon(str(CONF / 'daemon.pid'))
    if len(sys.argv) == 2:
        if 'start' == sys.argv[1]:
            dbg('[+] starting server')
            init()
            daemon.start()
        elif 'stop' == sys.argv[1]:
            dbg('[+] stopping server')
            daemon.stop()
        elif 'restart' == sys.argv[1]:
            dbg('[+] restarting server')
            init()
            daemon.restart()
        else:
            print("Unknown command")
            sys.exit(2)

        sys.exit(0)
    else:
        print("usage: %s start|stop|restart" % sys.argv[0])
        sys.exit(2)
