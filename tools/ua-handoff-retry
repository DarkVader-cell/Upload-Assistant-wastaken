#!/usr/bin/env bash
# Periodic, credential-in-memory retry for eligible Clementine -> Grape handoffs.
# The worker holds the authoritative lock and state; this launcher only ensures
# that a temporary Grape outage is retried later without storing a password.
set -euo pipefail

set -a
. /home/artemis/.config/upload-assistant/whatbox.env
set +a
export SSHPASS="$UA_WHATBOX_PASSWORD"

printf '%s\n' "$UA_WHATBOX_PASSWORD" | sshpass -e ssh \
  -o BatchMode=no \
  -o ConnectTimeout=20 \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=2 \
  artemisprime@clementine.whatbox.ca \
  /mnt/nvme11n1/artemisprime/Upload-Assistant-wastaken/bin/handoff-to-grape.py \
  --password-stdin
