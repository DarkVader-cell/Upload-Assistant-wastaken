#!/usr/bin/env bash
# Run the VPS handoff without persisting the Whatbox password on the VPS.
# This launcher must run on the credential-holding host and requires it online.
set -euo pipefail
umask 077
mkdir -p "$HOME/.cache"
exec 9>"$HOME/.cache/ua-hbd-to-destiny-launcher.lock"
if ! flock -n 9; then
    echo 'HBD-to-Destiny launcher already running; skipping.'
    exit 0
fi
whatbox_password=$(
    set -a
    source "$HOME/.config/upload-assistant/whatbox.env"
    set +a
    printf '%s' "${UA_WHATBOX_PASSWORD:?Whatbox password is unavailable}"
)
SSHPASS=$(<"$HOME/.config/hbd/password")
if [[ -z "$SSHPASS" || -z "$whatbox_password" ]]; then
    echo 'Required credential is empty.' >&2
    exit 1
fi
export SSHPASS
printf '%s\n' "$whatbox_password" | sshpass -e ssh -T -p 6969 \
    -o StrictHostKeyChecking=yes -o ConnectTimeout=20 \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
    artemis@95.211.41.14 \
    'python3 -u /home/artemis/bin/hbd-to-whatbox-hdd.py --password-stdin'
