# Version control
.git
.gitignore
.github
graphify-out

# Python bytecode & caches
**/__pycache__
**/*.pyc
**/*.pyo
*.egg-info
.mypy_cache
.ruff_cache
.pytest_cache
.coverage
coverage.xml

# Virtual environments (host-side; the image builds its own at /opt/venv)
venv
.venv
**/node_modules

# IDE / editor
.vscode
.cursor
.idea
*.swp
*.swo

# Docker files (not needed inside the image)
docker-compose.yml
docker-compose.local.yml
Dockerfile
.dockerignore

# Documentation (not needed at runtime)
docs
benchmarks

# Runtime artifacts that should not leak into the build context
tmp
docker-data
*.torrent
*.log
**/*.log

# Host configuration, credentials, and mutable application state
data/config.py
data/access_log.log
data/session_secret
data/sessions
data/*.db
data/*.sqlite*
data/cookies/*
!data/cookies/README.md

# Platform-specific binaries that cannot run in Linux containers
bin/MI/windows

# OS junk
Thumbs.db
.DS_Store

# Tests / CI
tests
.bandit.yaml
bandit.yaml
uv.lock
