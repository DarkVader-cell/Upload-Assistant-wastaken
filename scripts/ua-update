#!/usr/bin/env bash
set -euo pipefail

# Load the optional Whatbox connection settings when this helper is invoked
# directly.  `source whatbox.env` alone does not export its variables to this
# child process, so export assignments while loading it.
whatbox_env_file="${UA_WHATBOX_ENV_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/upload-assistant/whatbox.env}"
if [[ -r "$whatbox_env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$whatbox_env_file"
    set +a
fi

repo_dir="${UA_REPO_DIR:-/home/artemis/Upload-Assistant-wastaken}"
compose_file="${UA_COMPOSE_FILE:-/opt/yams/docker-compose.yaml}"
env_file="${UA_COMPOSE_ENV:-/opt/yams/.env}"
whatbox_host="${UA_WHATBOX_HOST:-grape.whatbox.ca}"
whatbox_user="${UA_WHATBOX_USER:-artemisprime}"
whatbox_repo="${UA_WHATBOX_REPO:-Upload-Assistant-wastaken}"

update_local() {
    echo "Updating local homelab..."
    cd "$repo_dir"
    git switch main
    git pull --ff-only origin main
    docker compose --env-file "$env_file" -f "$compose_file" pull upload-assistant
    docker compose --env-file "$env_file" -f "$compose_file" up -d --force-recreate upload-assistant
    docker compose --env-file "$env_file" -f "$compose_file" ps upload-assistant
}

update_whatbox() {
    : "${UA_WHATBOX_PASSWORD:?Set UA_WHATBOX_PASSWORD in ~/.config/upload-assistant/whatbox.env}"
    echo "Updating Whatbox..."
    export SSHPASS="$UA_WHATBOX_PASSWORD"
    sshpass -e ssh -o PubkeyAuthentication=no -o PreferredAuthentications=password \
        -o StrictHostKeyChecking=yes "$whatbox_user@$whatbox_host" \
        "cd ~/$whatbox_repo && podman pull ghcr.io/darkvader-cell/upload-assistant-wastaken:latest && podman tag ghcr.io/darkvader-cell/upload-assistant-wastaken:latest localhost/upload-assistant-wastaken:local && podman rm -f upload-assistant-wastaken 2>/dev/null || true; podman pod rm -f upload-assistant-wastaken 2>/dev/null || true; cd ~/$whatbox_repo && podman compose -f docker-compose.local.yml up -d --no-build upload-assistant-wastaken && podman ps --filter name=upload-assistant-wastaken --format 'table {{.Names}}\\t{{.Status}}\\t{{.Image}}'"
}

case "${1:-}" in
    local)
        update_local
        ;;
    whatbox)
        update_whatbox
        ;;
    "")
        update_local
        update_whatbox
        ;;
    *)
        echo "Usage: ua update [local|whatbox]" >&2
        exit 2
        ;;
esac
